# =============================================================================
# Looker + Gemini Enterprise via ADK + MCP Toolbox
# =============================================================================
# Copy this file to .env and fill in your values.

# ----- GCP -----
# The project where the ADK Reasoning Engine and Discovery Engine resources live.
# This is also where the GE app is provisioned.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-project-id-adk-staging

# ----- Looker -----
LOOKERSDK_BASE_URL=https://your-instance.cloud.looker.com

# API3 credentials of an admin user on the Looker instance.
# Used ONCE by 01-register-looker-oauth-app.sh to create the OAuth client app.
# Get these from: Looker → Admin → Users → [your admin user] → Edit Keys → API3 Keys
LOOKERSDK_CLIENT_ID=your-api3-client-id
LOOKERSDK_CLIENT_SECRET=your-api3-client-secret

# The GUID for the OAuth client app the PKCE proxy will use to talk to Looker.
# Pick any URL-safe identifier, e.g. "gemini-enterprise-prod". Keep it stable —
# changing it invalidates all existing user consents on the Looker side.
LOOKER_OAUTH_CLIENT_ID=gemini-enterprise-prod

# ----- PKCE Proxy -----
# Where the proxy will be deployed (can be same project as everything else).
PKCE_PROXY_PROJECT=your-project-id
PKCE_PROXY_REGION=us-central1
PKCE_PROXY_FUNCTION_NAME=looker-pkce-proxy

# Shared secret between Gemini Enterprise and the proxy.
# GE will send this as `client_secret` in token exchanges; the proxy validates it.
# Use a real random value: openssl rand -hex 32
PKCE_PROXY_CLIENT_SECRET=replace-with-random-secret

# Identifier GE uses as `client_id` (cosmetic, validated by the proxy is the secret).
PKCE_PROXY_CLIENT_ID=looker-via-proxy

# ----- MCP Toolbox -----
# Where the toolbox-oauth Cloud Run service will be deployed.
TOOLBOX_PROJECT=your-project-id
TOOLBOX_REGION=us-central1
TOOLBOX_SERVICE_NAME=toolbox-oauth

# After deploy, this gets populated automatically.
MCP_SERVER_URL=https://toolbox-oauth-XXXX.us-central1.run.app/mcp

# ----- Gemini Enterprise -----
# The engineId of your existing GE app. You must have already created the engine
# in the Gemini Enterprise console. Find the ID in the URL when viewing your engine:
#   https://console.cloud.google.com/gen-app-builder/engines/<engineId>/...
# It looks like a name with a numeric suffix, e.g. "my-engine_1752677764069"
GE_ENGINE_ID=your-engine-id_1234567890

# Identifier for the OAuth authorization resource we'll register in Discovery Engine.
# IMPORTANT: GE caches user OAuth state per (user, auth_id). If you need to force
# re-consent during development, change this to a new value (e.g. looker-oauth-v2).
AUTH_ID=looker-oauth

# Identifier for the agent we'll register in GE.
AGENT_ID=looker_mcp_agent

# After 05-deploy-adk-agent.sh, this gets populated.
REASONING_ENGINE_ID=projects/PROJECT_NUMBER/locations/us-central1/reasoningEngines/XXXXX

# ----- ADK Agent runtime -----
# These get baked into the deployed Reasoning Engine via .env file
MCP_SERVER_MODEL=gemini-2.5-flash
